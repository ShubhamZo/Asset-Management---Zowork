  "components": {
    "schemas": {
      "AssetStatus": {
        "enum": [
          "Active",
          "Issued",
          "UnderMaintenance",
          "Retired"
        ],
        "type": "string"
      },
      "CreateAssetAssignmentDTO": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "integer",
            "format": "int32"
          },
          "employeeId": {
            "type": "integer",
            "format": "int32"
          },
          "assignedDate": {
            "type": "string",
            "format": "date-time"
          },
          "expectedReturnDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "conditionAtIssue": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateAssetDTO": {
        "type": "object",
        "properties": {
          "assetName": {
            "type": "string",
            "nullable": true
          },
          "assetType": {
            "type": "string",
            "nullable": true
          },
          "serialNumber": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/AssetStatus"
          },
          "purchaseDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreateEmployeeDTO": {
        "required": [
          "department",
          "email",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "department": {
            "$ref": "#/components/schemas/Department"
          }
        },
        "additionalProperties": false
      },
      "CreateTicketDto": {
        "required": [
          "assetId",
          "description",
          "employeeId",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "assetId": {
            "type": "integer",
            "format": "int32"
          },
          "employeeId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateUserDTO": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "employeeId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Department": {
        "enum": [
          "HR",
          "IT",
          "Development",
          "Testing",
          "Finance",
          "Operations",
          "Sales",
          "Support"
        ],
        "type": "string"
      },
      "LoginDTO": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReturnAssetDTO": {
        "type": "object",
        "properties": {
          "assignmentId": {
            "type": "integer",
            "format": "int32"
          },
          "conditionAtReturn": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateAssetAssignmentDTO": {
        "type": "object",
        "properties": {
          "actualReturnDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "conditionAtReturn": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateAssetDTO": {
        "type": "object",
        "properties": {
          "assetName": {
            "type": "string",
            "nullable": true
          },
          "assetType": {
            "type": "string",
            "nullable": true
          },
          "serialNumber": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/AssetStatus"
          },
          "purchaseDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "UserRole": {
        "enum": [
          "Admin",
          "Employee"
        ],
        "type": "string"
      }
    }
